{% extends 'base.html.twig' %}

{% block title %}Mes documents — OWNER{% endblock %}

{% block body %}
<div class="page-header">
    <h1>Mes documents</h1>
    <div class="page-header-actions">
        {# <a href="{{ path('app_client_document_bulk_form') }}" class="btn-secondary">Classer en masse</a> #}
        <a href="{{ path('app_client_document_upload') }}" class="btn-primary">Déposer des documents</a>
    </div>
</div>

<form method="get" class="filters">
    <select name="year">
        <option value="">Toutes les années</option>
        {% for y in availableYears %}
            <option value="{{ y }}" {{ currentYear == y ? 'selected' : '' }}>{{ y }}</option>
        {% endfor %}
    </select>

    <select name="month">
        <option value="">Tous les mois</option>
        {% set mois = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'] %}
        {% for i in 1..12 %}
            <option value="{{ i }}" {{ currentMonth == i ? 'selected' : '' }}>{{ mois[i-1] }}</option>
        {% endfor %}
    </select>

    <select name="nature">
        <option value="">Toutes les natures</option>
        {% for n in natures %}
            <option value="{{ n.value }}" {{ currentNature and currentNature.value == n.value ? 'selected' : '' }}>
                {{ n.label() }}
            </option>
        {% endfor %}
    </select>

    <input type="hidden" name="limit" value="{{ limit }}">

    <button type="submit" class="btn-primary">Filtrer</button>
    <a href="{{ path('app_client_document_list') }}" class="btn-secondary">Réinitialiser</a>
</form>

{% if pagination.totalItemCount == 0 %}
    <div class="empty-state">
        <p>Aucun document trouvé.</p>
        {% if currentYear or currentMonth or currentNature %}
            <p>Essayez d'élargir vos filtres.</p>
            <a href="{{ path('app_client_document_list') }}" class="btn-secondary">Voir tous les documents</a>
        {% else %}
            <a href="{{ path('app_client_document_upload') }}">Déposer votre premier document</a>
        {% endif %}
    </div>
{% else %}
    <p class="total-info">{{ pagination.totalItemCount }} document(s) — page {{ pagination.currentPageNumber }} / {{ pagination.pageCount }}</p>

    <table class="document-table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Nature</th>
                <th>Période</th>
                <th>Statut</th>
                <th>Déposé le</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for document in pagination %}
            <tr>
                <td>{{ document.originalName }}</td>
                <td>{{ document.nature ? document.nature.label() : '—' }}</td>
                <td>{{ document.formattedPeriod ?? '—' }}</td>
                <td>
                    <span class="badge badge-{{ document.status.color() }}">
                        {{ document.status.label() }}
                    </span>
                </td>
                <td>{{ document.createdAt|date('d/m/Y H:i') }}</td>
                <td>
                    <a href="{{ path('app_client_document_show', {id: document.id}) }}">Voir</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="pagination">
        {{ knp_pagination_render(pagination) }}
    </div>
{% endif %}
{% endblock %}