{% extends 'base.html.twig' %}

{% block title %}Classer en masse — OWNER{% endblock %}

{% block body %}
<h1>Classer en masse</h1>
<p class="muted">Documents non classés : {{ documents|length }}</p>

{% if documents is empty %}
    <div class="empty-state">
        <p>Tous vos documents sont classés. 👌</p>
        <a href="{{ path('app_client_document_list') }}">Retour à la liste</a>
    </div>
{% else %}
<form method="post" class="bulk-form">
    <input type="hidden" name="_token" value="{{ csrf_token('bulk_edit') }}">

    <table class="document-table">
        <thead>
            <tr>
                <th><input type="checkbox" id="select-all"></th>
                <th>Nom</th>
                <th>Nature</th>
                <th>Déposé le</th>
            </tr>
        </thead>
        <tbody>
        {% for doc in documents %}
            <tr>
                <td>
                    <input type="checkbox" name="document_ids[]" value="{{ doc.id }}">
                </td>
                <td>{{ doc.originalName }}</td>
                <td>{{ doc.nature?.label() }}</td>
                <td>{{ doc.createdAt|date('d/m/Y') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <fieldset class="bulk-actions  document-card">
        <legend>Appliquer à la sélection</legend>

        <div class="form-row">
            <label>Nature</label>
            <select name="nature">
                <option value="">— Ne pas modifier —</option>
                {% for nature in natures %}
                    <option value="{{ nature.value }}">{{ nature.label() }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-row">
            <label>Année</label>
            <input type="number" name="periodYear" min="2000" max="2100" placeholder="2024">
        </div>

        <div class="form-row">
            <label>Mois</label>
            <select name="periodMonth">
                <option value="">— Tous —</option>
                {% set mois = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'] %}
                {% for i in 1..12 %}
                    <option value="{{ i }}">{{ mois[i-1] }}</option>
                {% endfor %}
            </select>
        </div>

        <button type="submit" class="btn-primary">Appliquer à la sélection</button>
    </fieldset>
</form>

<script>
    document.getElementById('select-all')?.addEventListener('change', (e) => {
    document.querySelectorAll('input[name="document_ids[]"]').forEach(cb => cb.checked = e.target.checked);
});
</script>
{% endif %}
{% endblock %}