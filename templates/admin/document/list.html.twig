{% extends 'base.html.twig' %}

{% block title %}Tous les documents — Admin{% endblock %}

{% block body %}
<div class="page-header">
    <h1>Documents ({{ pagination.totalItemCount }})</h1>
    <a href="{{ path('app_admin_dashboard') }}">← Dashboard</a>
</div>

<form method="get" class="filters">
    <select name="status">
        <option value="">Tous les statuts</option>
        {% for s in statuses %}
            <option value="{{ s.value }}" {{ currentStatus and currentStatus.value == s.value ? 'selected' : '' }}>
                {{ s.label() }}
            </option>
        {% endfor %}
    </select>

    <select name="client">
        <option value="">Tous les clients</option>
        {% for c in clients %}
            <option value="{{ c.id }}" {{ currentClient and currentClient.id == c.id ? 'selected' : '' }}>
                {{ c.name }}
            </option>
        {% endfor %}
    </select>

    <button type="submit" class="btn-primary">Filtrer</button>
    <a href="{{ path('app_admin_document_list') }}" class="btn-secondary">Réinitialiser</a>
</form>

{% if pagination.totalItemCount == 0 %}
    <div class="empty-state"><p>Aucun document trouvé.</p></div>
{% else %}
    <table class="document-table">
        <thead>
            <tr>
                <th>Client</th>
                <th>Nom</th>
                <th>Nature</th>
                <th>Statut</th>
                <th>Déposé le</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for document in pagination %}
            <tr>
                <td>{{ document.client.name }}</td>
                <td>{{ document.originalName }}</td>
                <td>{{ document.nature ? document.nature.label() : '—' }}</td>
                <td>
                    <span class="badge badge-{{ document.status.color() }}">
                        {{ document.status.label() }}
                    </span>
                </td>
                <td>{{ document.createdAt|date('d/m/Y H:i') }}</td>
                <td>
                    <a href="{{ path('app_admin_document_show', {id: document.id}) }}">Voir</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="pagination">
        {{ knp_pagination_render(pagination) }}
    </div>
{% endif %}
{% endblock %}